CREATE TABLE ManqobahEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    chapter_number INTEGER NOT NULL,
    title_arabic TEXT NOT NULL,
    title_indonesian TEXT NOT NULL,
    title_sundanese TEXT NOT NULL,
    content_arabic TEXT NOT NULL,
    content_indonesian TEXT NOT NULL,
    content_sundanese TEXT NOT NULL,
    audio_path TEXT
);

CREATE INDEX manqobah_chapter_idx ON ManqobahEntity(chapter_number);

CREATE TABLE BookmarkEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    item_type TEXT NOT NULL,
    item_id TEXT NOT NULL,
    title TEXT NOT NULL,
    subtitle TEXT NOT NULL,
    page_or_surah INTEGER NOT NULL DEFAULT 0,
    verse_or_section INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX bookmark_type_idx ON BookmarkEntity(item_type);

CREATE TABLE AmaliyahProgressEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    current_count INTEGER NOT NULL DEFAULT 0,
    target_count INTEGER NOT NULL DEFAULT 33,
    last_updated INTEGER NOT NULL,
    is_completed INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX amaliyah_progress_idx ON AmaliyahProgressEntity(id);

-- Manqobah Queries
getAllManqobah:
SELECT * FROM ManqobahEntity ORDER BY chapter_number ASC;

getManqobahByChapter:
SELECT * FROM ManqobahEntity WHERE chapter_number = :chapterNumber LIMIT 1;

searchManqobah:
SELECT * FROM ManqobahEntity
WHERE title_indonesian LIKE '%' || :query || '%'
   OR title_sundanese LIKE '%' || :query || '%'
   OR content_indonesian LIKE '%' || :query || '%'
   OR content_sundanese LIKE '%' || :query || '%'
ORDER BY chapter_number ASC;

insertManqobah:
INSERT OR REPLACE INTO ManqobahEntity(
    id, chapter_number, title_arabic, title_indonesian, title_sundanese,
    content_arabic, content_indonesian, content_sundanese, audio_path
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteManqobahByChapter:
DELETE FROM ManqobahEntity WHERE chapter_number = :chapterNumber;

deleteAllManqobah:
DELETE FROM ManqobahEntity;

-- Bookmark Queries
getAllBookmarks:
SELECT * FROM BookmarkEntity ORDER BY updated_at DESC;

getBookmarksByType:
SELECT * FROM BookmarkEntity WHERE item_type = :itemType ORDER BY updated_at DESC;

getBookmarkByItem:
SELECT * FROM BookmarkEntity WHERE item_type = :itemType AND item_id = :itemId LIMIT 1;

getLastReadBookmark:
SELECT * FROM BookmarkEntity WHERE item_type = :itemType ORDER BY updated_at DESC LIMIT 1;

insertOrUpdateBookmark:
INSERT OR REPLACE INTO BookmarkEntity(
    id, item_type, item_id, title, subtitle, page_or_surah, verse_or_section, created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteBookmarkById:
DELETE FROM BookmarkEntity WHERE id = :id;

deleteBookmarkByItem:
DELETE FROM BookmarkEntity WHERE item_type = :itemType AND item_id = :itemId;

-- Amaliyah Progress Queries
getAllAmaliyahProgress:
SELECT * FROM AmaliyahProgressEntity ORDER BY last_updated DESC;

getAmaliyahProgressById:
SELECT * FROM AmaliyahProgressEntity WHERE id = :id LIMIT 1;

insertOrUpdateAmaliyahProgress:
INSERT OR REPLACE INTO AmaliyahProgressEntity(
    id, title, current_count, target_count, last_updated, is_completed
) VALUES (?, ?, ?, ?, ?, ?);

updateAmaliyahCount:
UPDATE AmaliyahProgressEntity
SET current_count = :currentCount,
    last_updated = :lastUpdated,
    is_completed = :isCompleted
WHERE id = :id;

resetAmaliyahProgress:
UPDATE AmaliyahProgressEntity
SET current_count = 0,
    is_completed = 0,
    last_updated = :lastUpdated
WHERE id = :id;

deleteAmaliyahProgress:
DELETE FROM AmaliyahProgressEntity WHERE id = :id;

-- Prayer Settings Entity
CREATE TABLE PrayerSettingsEntity (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    method_id TEXT NOT NULL DEFAULT 'KEMENAG',
    imsak_offset INTEGER NOT NULL DEFAULT 0,
    subuh_offset INTEGER NOT NULL DEFAULT 0,
    terbit_offset INTEGER NOT NULL DEFAULT 0,
    dzuhur_offset INTEGER NOT NULL DEFAULT 0,
    ashar_offset INTEGER NOT NULL DEFAULT 0,
    maghrib_offset INTEGER NOT NULL DEFAULT 0,
    isya_offset INTEGER NOT NULL DEFAULT 0,
    madhab TEXT NOT NULL DEFAULT 'SHAFI',
    custom_lat REAL,
    custom_lng REAL,
    custom_location_name TEXT,
    custom_timezone_offset REAL,
    is_gps INTEGER NOT NULL DEFAULT 0,
    selected_adzan_voice_id TEXT NOT NULL DEFAULT 'misyari_rasyid',
    custom_adzan_audio_path TEXT,
    adzan_volume REAL NOT NULL DEFAULT 1.0,
    subuh_notif_enabled INTEGER NOT NULL DEFAULT 1,
    dzuhur_notif_enabled INTEGER NOT NULL DEFAULT 1,
    ashar_notif_enabled INTEGER NOT NULL DEFAULT 1,
    maghrib_notif_enabled INTEGER NOT NULL DEFAULT 1,
    isya_notif_enabled INTEGER NOT NULL DEFAULT 1,
    imsak_notif_enabled INTEGER NOT NULL DEFAULT 0,
    pre_reminder_enabled INTEGER NOT NULL DEFAULT 1
);

getPrayerSettings:
SELECT * FROM PrayerSettingsEntity WHERE id = 1 LIMIT 1;

insertOrUpdatePrayerSettings:
INSERT OR REPLACE INTO PrayerSettingsEntity(
    id, method_id, imsak_offset, subuh_offset, terbit_offset, dzuhur_offset, ashar_offset, maghrib_offset, isya_offset, madhab,
    custom_lat, custom_lng, custom_location_name, custom_timezone_offset, is_gps,
    selected_adzan_voice_id, custom_adzan_audio_path, adzan_volume,
    subuh_notif_enabled, dzuhur_notif_enabled, ashar_notif_enabled, maghrib_notif_enabled, isya_notif_enabled, imsak_notif_enabled,
    pre_reminder_enabled
) VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateCalculationMethod:
UPDATE PrayerSettingsEntity
SET method_id = :methodId
WHERE id = 1;

updateLocation:
UPDATE PrayerSettingsEntity
SET custom_lat = :customLat,
    custom_lng = :customLng,
    custom_location_name = :customLocationName,
    custom_timezone_offset = :customTimezoneOffset,
    is_gps = :isGps
WHERE id = 1;

updateAdzanVoice:
UPDATE PrayerSettingsEntity
SET selected_adzan_voice_id = :selectedAdzanVoiceId,
    custom_adzan_audio_path = :customAdzanAudioPath
WHERE id = 1;

updatePrayerNotificationToggles:
UPDATE PrayerSettingsEntity
SET subuh_notif_enabled = :subuh,
    dzuhur_notif_enabled = :dzuhur,
    ashar_notif_enabled = :ashar,
    maghrib_notif_enabled = :maghrib,
    isya_notif_enabled = :isya,
    imsak_notif_enabled = :imsak,
    pre_reminder_enabled = :preReminderEnabled
WHERE id = 1;

updateAdzanVolume:
UPDATE PrayerSettingsEntity
SET adzan_volume = :adzanVolume
WHERE id = 1;

-- Reader Settings Entity
CREATE TABLE ReaderSettingsEntity (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    font_scale REAL NOT NULL DEFAULT 1.0,
    theme_id TEXT NOT NULL DEFAULT 'system'
);

getReaderSettings:
SELECT * FROM ReaderSettingsEntity WHERE id = 1 LIMIT 1;

insertOrUpdateReaderSettings:
INSERT OR REPLACE INTO ReaderSettingsEntity(
    id, font_scale, theme_id
) VALUES (1, :fontScale, :themeId);

updateFontScale:
UPDATE ReaderSettingsEntity
SET font_scale = :fontScale
WHERE id = 1;

updateReaderTheme:
UPDATE ReaderSettingsEntity
SET theme_id = :themeId
WHERE id = 1;

-- Cached Document Entity (Cloud Sync for Markdown Liturgy Documents)
CREATE TABLE CachedDocumentEntity (
    id TEXT NOT NULL PRIMARY KEY,
    file_name TEXT NOT NULL,
    sha256 TEXT NOT NULL,
    content TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX cached_doc_filename_idx ON CachedDocumentEntity(file_name);

getCachedDocument:
SELECT * FROM CachedDocumentEntity WHERE id = :id LIMIT 1;

getCachedDocumentByFileName:
SELECT * FROM CachedDocumentEntity WHERE file_name = :fileName LIMIT 1;

getAllCachedDocumentHashes:
SELECT file_name, sha256 FROM CachedDocumentEntity;

insertOrUpdateCachedDocument:
INSERT OR REPLACE INTO CachedDocumentEntity(
    id, file_name, sha256, content, updated_at
) VALUES (?, ?, ?, ?, ?);

deleteCachedDocument:
DELETE FROM CachedDocumentEntity WHERE id = :id;

deleteAllCachedDocuments:
DELETE FROM CachedDocumentEntity;

